      <aliases enabled='yes' />
      <column caption='Age Group' datatype='string' name='[Calculation_1831846714048513]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &lt; 30 THEN &quot;18-29&quot;&#13;&#10;ELSEIF [age] &lt; 40 THEN &quot;30-39&quot;&#13;&#10;ELSEIF [age] &lt; 50 THEN &quot;40-49&quot;&#13;&#10;ELSEIF [age] &lt; 60 THEN &quot;50-59&quot;&#13;&#10;ELSEIF [age] &lt; 70 THEN &quot;60-69&quot;&#13;&#10;ELSE &quot;70-79&quot;&#13;&#10;END' />
      </column>
      <column caption='BMI Category' datatype='string' name='[Calculation_1831846714679298]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bmi] &lt; 18.5 THEN &quot;Underweight&quot;&#13;&#10;ELSEIF [bmi] &lt; 25 THEN &quot;Normal&quot;&#13;&#10;ELSEIF [bmi] &lt; 30 THEN &quot;Overweight&quot;&#13;&#10;ELSE &quot;Obese&quot;&#13;&#10;END' />
      </column>
      <column caption='Heart Disease Status' datatype='string' name='[Calculation_1831846714912771]' role='dimension' type='nominal'>
